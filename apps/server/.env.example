NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

DATABASE_URL=postgresql://collab:collab@localhost:5432/collab?schema=public
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+chars
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

CORS_ORIGIN=http://localhost:5173
SOCKET_IO_REDIS_ADAPTER=true

# Optional AWS (S3 file attachments). When empty the file API responds 503.
AWS_REGION=us-east-1
S3_BUCKET=
S3_PRESIGN_TTL_SECONDS=3600
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
