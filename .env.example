# =====================================================
# Root environment template
# Copy to .env (and apps/server/.env, apps/web/.env) for local dev
# =====================================================

# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Postgres (matches docker-compose service)
DATABASE_URL=postgresql://collab:collab@localhost:5432/collab?schema=public

# Redis (matches docker-compose service)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-please-use-32+chars
JWT_REFRESH_SECRET=change-me-refresh-secret-please-use-32+chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS / origins
CORS_ORIGIN=http://localhost:5173

# Socket.IO scaling (optional)
SOCKET_IO_REDIS_ADAPTER=true

# --- AWS (all optional; app runs without these) ---
AWS_REGION=us-east-1
S3_BUCKET=
S3_PRESIGN_TTL_SECONDS=3600
# If set, signed URLs are returned for uploads. Otherwise file features are disabled gracefully.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Web ---
VITE_API_URL=http://localhost:4000
VITE_WS_URL=http://localhost:4000
