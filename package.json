{
  "name": "realtime-collab-app",
  "private": true,
  "version": "0.1.0",
  "description": "Real-time collaborative Kanban workspace (FAANG-style portfolio project)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev -w @collab/server\" \"npm:dev -w @collab/web\"",
    "dev:server": "npm run dev -w @collab/server",
    "dev:web": "npm run dev -w @collab/web",
    "build": "npm run build -w @collab/shared && npm run build -w @collab/server && npm run build -w @collab/web",
    "lint": "npm run lint -w @collab/server && npm run lint -w @collab/web",
    "test": "npm run test -w @collab/server",
    "prisma:generate": "npm run prisma:generate -w @collab/server",
    "prisma:migrate": "npm run prisma:migrate -w @collab/server",
    "prisma:studio": "npm run prisma:studio -w @collab/server",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
